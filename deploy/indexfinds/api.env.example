# Copy to /opt/indexfinds/env/api.env on the new VPS.
# This file contains placeholders only and is safe to commit.
NODE_ENV=production
PORT=4101
SITE_NAME=IndexFinds
# Closed by default. Set to true only when public account creation is ready.
PUBLIC_REGISTRATION_ENABLED=false

DB_HOST=postgres
DB_PORT=5432
DB_USER=indexfinds
DB_PASSWORD=REPLACE_WITH_SAME_POSTGRES_PASSWORD_AS_COMPOSE
DB_NAME=indexfinds
DB_SSL=false

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_SAME_REDIS_PASSWORD_AS_COMPOSE

JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
JWT_ACCESS_EXPIRATION=2h
JWT_REFRESH_EXPIRATION_DAYS=30
OAUTH_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY

FRONTEND_URL=https://indexfinds.com
SITE_URL=https://indexfinds.com
API_URL=https://api.indexfinds.com
CORS_ORIGIN=https://indexfinds.com,https://www.indexfinds.com
# Restrict Vercel preview access to this exact project and owning team.
CORS_VERCEL_PREVIEW_PROJECT=indexfinds
CORS_VERCEL_PREVIEW_OWNER=REPLACE_WITH_VERCEL_TEAM_SLUG
TRAFFIC_INTERNAL_DOMAINS=indexfinds.com,www.indexfinds.com,api.indexfinds.com
TRAFFIC_OWNED_DOMAINS=lolobuyspreadsheets.com,www.lolobuyspreadsheets.com
TRUST_PROXY=true
# Optional but strongly recommended: comma-separated fixed public IPs allowed
# to use administrator APIs. Leave empty until the operator IP is confirmed.
ADMIN_ALLOWED_IPS=

REVALIDATE_SECRET=REPLACE_WITH_SHARED_REVALIDATE_SECRET
REFERRAL_TRACKING_SECRET=REPLACE_WITH_SHARED_REFERRAL_SECRET

MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_API_KEY=REPLACE_WITH_SAME_MEILISEARCH_KEY_AS_COMPOSE
SEARCH_ENGINE=meilisearch
# The legacy full-catalog BM25 term scan is expensive. Meilisearch remains the
# primary engine; enable this only after validating the query on production data.
BM25_REFRESH_STATS_ENABLED=false
EMBEDDING_SERVICE_URL=http://embedding-service:8001
VISUAL_SEARCH_UPLOAD_ENABLED=true
UPLOADS_PATH=/app/uploads

RESEND_API_KEY=REPLACE_WITH_RESEND_API_KEY
EMAIL_FROM=IndexFinds <noreply@indexfinds.com>

GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_CLIENT_SECRET
GOOGLE_CALLBACK_URL=https://api.indexfinds.com/auth/google/callback

# Optional integrations. Leave empty when the feature is disabled.
QWEN_API_KEY=
EXCHANGE_RATE_API_KEY=
IPINFO_TOKEN=
