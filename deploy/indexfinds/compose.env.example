# Copy to /opt/indexfinds/env/compose.env on the new VPS.
# Replace every REPLACE_WITH_* value before deployment.
COMPOSE_PROJECT_NAME=indexfinds

POSTGRES_USER=indexfinds
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_POSTGRES_PASSWORD
POSTGRES_DB=indexfinds
POSTGRES_PORT_BIND=127.0.0.1:5432

REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD
REDIS_PORT_BIND=127.0.0.1:6379

MEILISEARCH_API_KEY=REPLACE_WITH_STRONG_MEILISEARCH_KEY
MEILISEARCH_PORT_BIND=127.0.0.1:7700
MEILISEARCH_ENV=production

API_PUBLIC_PORT_BIND=127.0.0.1:4101
EMBEDDING_SERVICE_PORT_BIND=127.0.0.1:8001
API_ENV_FILE=/opt/indexfinds/env/api.env
UPLOADS_HOST_PATH=/opt/indexfinds/data/uploads
HF_CACHE_HOST_PATH=/opt/indexfinds/data/hf-cache

CORS_ALLOWED_ORIGINS=https://indexfinds.com,https://www.indexfinds.com,https://api.indexfinds.com
