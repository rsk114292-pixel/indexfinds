# Install as /opt/indexfinds/env/backup.env with mode 0600.
INDEXFINDS_APP_DIR=/opt/indexfinds/app
INDEXFINDS_COMPOSE_ENV=/opt/indexfinds/env/compose.env
INDEXFINDS_BACKUP_DIR=/opt/indexfinds/backups/daily

# rclone destination configured on the VPS, for example:
#   s3-indexfinds:indexfinds-production/postgres
INDEXFINDS_BACKUP_REMOTE=REPLACE_WITH_RCLONE_REMOTE_AND_PATH
RCLONE_CONFIG=/opt/indexfinds/env/rclone.conf

# Public age recipient. Keep the matching private identity offline.
INDEXFINDS_BACKUP_AGE_RECIPIENT=REPLACE_WITH_AGE_PUBLIC_RECIPIENT

INDEXFINDS_LOCAL_RETENTION_DAYS=7
INDEXFINDS_REMOTE_RETENTION_DAYS=30
