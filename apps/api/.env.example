# 数据库配置
DB_HOST=127.0.0.1
DB_PORT=15432
DB_USER=postgres
DB_PASSWORD=change_me_local_dev_password
DB_NAME=lolobuyspreadsheets_dev
# 是否启用 SSL 连接（Docker 内部网络设 false，云托管数据库设 true）
DB_SSL=false

# Redis 配置
REDIS_HOST=localhost
REDIS_PORT=16379
# Redis 密码（生产环境必须设置，开发环境可留空）
# 生成方法: openssl rand -base64 24
REDIS_PASSWORD=

# JWT 认证配置 (必须配置!)
# 生成方法: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_here
# Access Token 过期时间 (默认 2h)
JWT_ACCESS_EXPIRATION=2h
# Refresh Token 过期天数 (默认 30)
JWT_REFRESH_EXPIRATION_DAYS=30

# OAuth Token 加密密钥（用于加密存储第三方 OAuth token）
# 生成方法: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# 所有环境均必须配置!
OAUTH_ENCRYPTION_KEY=

# 通义千问 AI 配置
QWEN_API_KEY=your_qwen_api_key
QWEN_API_ENDPOINT=https://dashscope.aliyuncs.com/api/v1/services/aigc/text-generation/generation

# ========== 邮件服务 (Resend) ==========
# 从 https://resend.com/api-keys 获取
RESEND_API_KEY=re_xxxx
# 域名验证通过后，填 noreply@你的域名
EMAIL_FROM=noreply@yourdomain.com

# ========== 前端地址 ==========
# 用于邮件中的链接（验证邮箱、重置密码）
# 本地开发用 http://localhost:3101，生产环境改成你的域名
FRONTEND_URL=http://localhost:3101

# ========== 流量来源归因 ==========
# 内部域名会被归为站内来源；自有旧域名/跳转域名会被归为自有站导流
SITE_URL=http://localhost:3101
TRAFFIC_INTERNAL_DOMAINS=localhost,127.0.0.1
TRAFFIC_OWNED_DOMAINS=

# ========== Next.js ISR 主动刷新 ==========
# API 保存产品后会调用前端 /api/revalidate，前后端必须配置相同的 secret
REVALIDATE_SECRET=your_revalidate_secret_here

# ========== CORS 跨域配置 ==========
# 允许的前端域名，HttpOnly Cookie 跨域必须配置
# 本地开发用 http://localhost:3101，生产环境改成你的域名
CORS_ORIGIN=http://localhost:3101

# ========== OAuth 社交登录 (Phase 3) ==========
# Google: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4101/auth/google/callback

# ========== API 服务地址 ==========
# 用于文件上传 URL 拼接等，生产环境改为实际 API 域名
API_URL=http://localhost:4101

# ========== Meilisearch 搜索引擎 ==========
# Meilisearch 服务地址
MEILISEARCH_HOST=http://localhost:17700
# Meilisearch API 密钥（生产环境必须设置强密钥）
# 生成方法: openssl rand -base64 32
MEILISEARCH_API_KEY=change_me_meilisearch_key
# 搜索引擎切换: postgres | meilisearch（过渡期默认 postgres）
SEARCH_ENGINE=postgres

# ========== Embedding Service ==========
# Python 嵌入服务地址 (本地默认 http://localhost:18001)
EMBEDDING_SERVICE_URL=http://localhost:18001

# ========== Visual Search ==========
VISUAL_SEARCH_UPLOAD_ENABLED=true

# ========== 账号安全 ==========
# 最大登录失败次数 (默认 5)
MAX_LOGIN_ATTEMPTS=5
# 账号锁定时长 (分钟, 默认 30)
LOCK_DURATION_MINUTES=30

# ========== 文件上传路径 ==========
# 静态文件存储路径（Docker 生产环境设 /app/uploads，开发环境可不设）
# UPLOADS_PATH=/app/uploads

# 环境
NODE_ENV=development
