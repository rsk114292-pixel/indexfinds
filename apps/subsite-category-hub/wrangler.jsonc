{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "indexfinds-subsite-category-hub",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "env": {
    "staging": {
      "name": "indexfinds-subsite-category-hub-staging",
      "workers_dev": true,
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1,
      },
    },
    "production": {
      "name": "indexfinds-subsite-category-hub-production",
      "workers_dev": false,
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1,
      },
