{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/check-cdn-webp.mjs",
    "build": "next build",
    "typecheck": "next typegen && tsc -p tsconfig.typecheck.json --noEmit",
    "start": "next start",
    "start:perf": "PORT=3001 next start",
    "lint": "eslint",
    "test": "jest",
    "test:route-smoke": "jest --runInBand --runTestsByPath 'src/app/__tests__/route-template-audit.test.tsx'",
    "test:visual-search": "jest --runInBand --runTestsByPath 'src/app/[locale]/(shop)/search/components/mobile/MobileProductBasedVisualSearch.test.tsx'",
    "test:e2e": "playwright test",
    "perf:lighthouse": "lhci autorun --config=./lighthouserc.cjs",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@ant-design/cssinjs": "^2.1.0",
