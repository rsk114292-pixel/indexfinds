    "lucide-react": "^0.562.0",
    "next": "15.5.23",
    "next-intl": "^4.13.6",
    "qrcode.react": "^4.2.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-image-crop": "^11.0.10",
    "sharp": "^0.35.3",
    "swr": "^2.3.8",
    "zustand": "^5.0.10"
