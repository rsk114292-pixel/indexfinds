    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/noto-sans-arabic": "5.3.0",
    "@microsoft/fetch-event-source": "^2.0.1",
    "@next/third-parties": "^16.1.6",
